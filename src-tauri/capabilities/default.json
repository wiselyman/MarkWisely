{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main MarkWisely desktop window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default",
    "process:default",
    "store:default",
    "log:default",
    "updater:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "window-state:default"
  ]
}
